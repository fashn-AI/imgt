{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imgt",
  "main": "src/index.ts",
  "assets": { "directory": "./dist/public" },
  "build": { "command": "npm run check && npm run build:site" },
  "keep_vars": true,
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["durable_object_io_tasks_prevent_eviction"],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "cache": {
    "enabled": true,
    "cross_version_cache": true
  },
  "exports": {
    "default": {
      "type": "worker",
      "cache": { "enabled": false }
    },
    "ImgtImageCache": {
      "type": "worker",
      "cache": { "enabled": true }
    }
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "ratelimits": [
    {
      "name": "IMAGE_RATE_LIMITER",
      "namespace_id": "2026090401",
      "simple": { "limit": 10000, "period": 60 }
    }
  ],
  "containers": [
    {
      "name": "imgt-transformer",
      "class_name": "ImgtNativeImageTransformer",
      "scheduling_policy": "durable_object",
      "images": {
        "sharp": { "dockerfile": "./container/Dockerfile" }
      },
      "observability": { "logs": { "enabled": true } }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "IMGT_NATIVE_TRANSFORMER",
        "class_name": "ImgtNativeImageTransformer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ImgtImageTransformer"]
    },
    {
      "tag": "v2-native-container",
      "new_sqlite_classes": ["ImgtNativeImageTransformer"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "DERIVATIVES",
      "bucket_name": "imgt"
    }
  ],
  "env": {
    "staging": {
      "name": "imgt-staging",
      "vars": {
        "ALLOWED_HOSTS": "images.unsplash.com,media.fashn.ai"
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      "ratelimits": [
        {
          "name": "IMAGE_RATE_LIMITER",
          "namespace_id": "2026100601",
          "simple": {
            "limit": 10000,
            "period": 60
          }
        }
      ],
      "containers": [
        {
          "name": "imgt-staging-transformer",
          "class_name": "ImgtNativeImageTransformer",
          "scheduling_policy": "durable_object",
          "images": {
            "sharp": {
              "dockerfile": "./container/Dockerfile"
            }
          },
          "observability": {
            "logs": {
              "enabled": true
            }
          }
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "IMGT_NATIVE_TRANSFORMER",
            "class_name": "ImgtNativeImageTransformer"
          }
        ]
      },
      "r2_buckets": [
        {
          "binding": "DERIVATIVES",
          "bucket_name": "imgt-staging"
        }
      ]
    }
  }
}
