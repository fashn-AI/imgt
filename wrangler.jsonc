{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imgt",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "cache": {
    "enabled": true,
    "cross_version_cache": true
  },
  "exports": {
    "default": {
      "type": "worker",
      "cache": { "enabled": false }
    },
    "ImgtImageCache": {
      "type": "worker",
      "cache": { "enabled": true }
    }
  },
  "observability": {
    "logs": { "enabled": true },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "ratelimits": [
    {
      "name": "IMAGE_RATE_LIMITER",
      "namespace_id": "2026090401",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "containers": [
    {
      "name": "imgt-transformer",
      "class_name": "ImgtImageTransformer",
      "image": "./container/Dockerfile",
      "max_instances": 4,
      "instance_type": {
        "vcpu": 1,
        "memory_mib": 3072,
        "disk_mb": 2000
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "IMGT_TRANSFORMER",
        "class_name": "ImgtImageTransformer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ImgtImageTransformer"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "DERIVATIVES",
      "bucket_name": "imgt-derivatives",
      "preview_bucket_name": "imgt-derivatives-dev"
    }
  ]
}
